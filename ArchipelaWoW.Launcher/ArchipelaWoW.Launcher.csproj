<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ArchipelaWoW.Launcher</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>ArchipelaWoW Launcher</Product>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UiDir>$(MSBuildProjectDirectory)\..\ui</UiDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Resources\config-defaults.json" LogicalName="config-defaults.json" />
  </ItemGroup>

  <!-- Release builds bundle the UI; skip with -p:SkipUiBuild=true when dist/ is already built. -->
  <Target Name="BuildUi" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' And '$(SkipUiBuild)' != 'true'">
    <Error Condition="!Exists('$(UiDir)\src\data\options-schema.json')"
           Text="The player options schema is missing: generate ui\src\data\options-schema.json from the apworld first, see the README." />
    <Exec Command="npm ci" WorkingDirectory="$(UiDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
  </Target>

  <!-- Items are added at execution time so that a dist/ produced by BuildUi is picked up in the same build. -->
  <Target Name="EmbedUi" AfterTargets="BuildUi" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <UiFile Include="$(UiDir)\dist\**\*" />
      <EmbeddedResource Include="@(UiFile)" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <Warning Condition="'@(UiFile)' == ''" Text="No UI found in $(UiDir)\dist: run 'npm run build' there, or start the launcher with --dev-server." />
  </Target>

  <!-- The notices of what the launcher bundles, published to licenses\ next to it -->
  <Target Name="PublishLicenses" AfterTargets="Publish">
    <ItemGroup>
      <_NetCoreRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(FrameworkName)' == 'Microsoft.NETCore.App'" />
      <LicenseFile Include="@(_NetCoreRuntimePack->'%(PackageDirectory)\LICENSE.TXT')" Name="Microsoft .NET.txt" />
      <LicenseFile Include="@(_NetCoreRuntimePack->'%(PackageDirectory)\THIRD-PARTY-NOTICES.TXT')" Name="Microsoft .NET third-party notices.txt" />
      <LicenseFile Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt" Name="WebView2 SDK.txt" />
      <LicenseFile Include="$(PkgMicrosoft_Web_WebView2)\NOTICE.txt" Name="WebView2 SDK notices.txt" />
      <LicenseFile Include="$(UiDir)\dist\.vite\license.md" Name="Launcher interface.md" />
    </ItemGroup>
    <Copy SourceFiles="@(LicenseFile)" DestinationFiles="@(LicenseFile->'$(PublishDir)licenses\%(Name)')" />
  </Target>

</Project>
