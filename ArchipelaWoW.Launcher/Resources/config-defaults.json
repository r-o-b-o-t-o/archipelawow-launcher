// Values applied when the launcher creates the .conf files from their .conf.dist, keyed by file
// (relative to server/configs). Strings are written quoted, numbers and booleans bare
// (true = 1), and {"raw": "..."} exactly as given. {mysqlPort} is replaced by the launcher's port.
// Keys missing from a file are appended to it.
//
// Paths are relative to server, the servers' working directory, which keeps the installation portable.
{
  "authserver.conf": {
    "LogsDir": "logs",
    "SourceDirectory": "source",
    "MySQLExecutable": "../mysql/bin/mysql.exe",
    "LoginDatabaseInfo": "127.0.0.1;{mysqlPort};acore;acore;acore_auth"
  },
  "worldserver.conf": {
    "DataDir": "data",
    "LogsDir": "logs",
    "SourceDirectory": "source",
    "MySQLExecutable": "../mysql/bin/mysql.exe",
    "LoginDatabaseInfo": "127.0.0.1;{mysqlPort};acore;acore;acore_auth",
    "WorldDatabaseInfo": "127.0.0.1;{mysqlPort};acore;acore;acore_world",
    "CharacterDatabaseInfo": "127.0.0.1;{mysqlPort};acore;acore;acore_characters",
    // Recommended by mod-i-found-your-sword: rewards arrive by mail, often several in a row
    "Mail.PushInboxOnDelivery": 1,
    // The authserver flags every realm offline when it starts, and a running worldserver clears it on
    // this interval (10 minutes by default): an authserver restart would list the realm offline that long
    "UpdateUptimeInterval": 1,
    "MailDeliveryDelay": 180,
    "EnablePlayerSettings": 1,
    "AllowTwoSide.Accounts": 1,
    "AllowTwoSide.Interaction.Calendar": 1,
    "AllowTwoSide.Interaction.Chat": 1,
    "AllowTwoSide.Interaction.Channel": 1,
    "AllowTwoSide.Interaction.Group": 1,
    "AllowTwoSide.Interaction.Guild": 1,
    "AllowTwoSide.Interaction.Auction": 1
  },
  "dbimport.conf": {
    "LogsDir": "logs",
    "SourceDirectory": "source",
    "MySQLExecutable": "../mysql/bin/mysql.exe",
    "LoginDatabaseInfo": "127.0.0.1;{mysqlPort};acore;acore;acore_auth",
    "WorldDatabaseInfo": "127.0.0.1;{mysqlPort};acore;acore;acore_world",
    "CharacterDatabaseInfo": "127.0.0.1;{mysqlPort};acore;acore;acore_characters"
  },
  "modules/archipelawow.conf": {
  },
  // The playerbots build's: mod-playerbots creates and updates this database itself
  "modules/playerbots.conf": {
    "PlayerbotsDatabaseInfo": "127.0.0.1;{mysqlPort};acore;acore;acore_playerbots"
  },
  "modules/transmog.conf": {
    "Transmogrification.UseVendorInterface": 1,
    "Transmogrification.AllowPoor": 1,
    "Transmogrification.AllowCommon": 1,
    "Transmogrification.AllowUncommon": 1,
    "Transmogrification.AllowRare": 1,
    "Transmogrification.AllowEpic": 1,
    "Transmogrification.AllowLegendary": 1,
    "Transmogrification.AllowArtifact": 1,
    "Transmogrification.AllowHeirloom": 1,
    "Transmogrification.AllowTradeable": 1,
    "Transmogrification.AllowMixedArmorTypes": 1,
    "Transmogrification.AllowLowerTiers": 1,
    "Transmogrification.AllowMixedOffhandArmorTypes": 1,
    "Transmogrification.AllowMixedWeaponTypes": 1,
    "Transmogrification.AllowMixedWeaponHandedness": 1,
    "Transmogrification.AllowFishingPoles": 1
  },
  "modules/SoloLfg.conf": {
    "SoloLFG.FixedXP": 0
  }
}
